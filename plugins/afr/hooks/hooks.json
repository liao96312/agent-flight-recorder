{
  "description": "AFR Codex Desktop hook contract probe. Records metadata only.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -File \"${PLUGIN_ROOT}/hooks/probe.ps1\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$env:PLUGIN_ROOT\\hooks\\probe.ps1\"",
            "timeout": 5,
            "statusMessage": "Probing AFR hook contract..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -File \"${PLUGIN_ROOT}/hooks/probe.ps1\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$env:PLUGIN_ROOT\\hooks\\probe.ps1\"",
            "timeout": 5,
            "statusMessage": "Probing AFR hook contract..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -File \"${PLUGIN_ROOT}/hooks/probe.ps1\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$env:PLUGIN_ROOT\\hooks\\probe.ps1\"",
            "timeout": 5,
            "statusMessage": "Probing AFR hook contract..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -File \"${PLUGIN_ROOT}/hooks/probe.ps1\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$env:PLUGIN_ROOT\\hooks\\probe.ps1\"",
            "timeout": 5,
            "statusMessage": "Probing AFR hook contract..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -File \"${PLUGIN_ROOT}/hooks/probe.ps1\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$env:PLUGIN_ROOT\\hooks\\probe.ps1\"",
            "timeout": 5,
            "statusMessage": "Probing AFR hook contract..."
          }
        ]
      }
    ]
  }
}
